    {
      "name": "RPC - Erro simulado (invalid op)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/rpc",
          "host": ["{{baseUrl}}"],
          "path": ["rpc"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"op\": \"invalid.op\",\n  \"data\": {}\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Contrato { ok, data, error, meta }', () => {",
              "  pm.expect(json).to.have.property('ok');",
              "  pm.expect(json).to.have.property('data');",
              "  pm.expect(json).to.have.property('error');",
              "  pm.expect(json).to.have.property('meta');",
              "});",
              "pm.test('Erro simulado retorna ok=false', () => {",
              "  pm.expect(json.ok).to.eql(false);",
              "});",
              "pm.test('Sem loop (tempo de resposta)', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(10000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "RPC - CRM offline (simulado)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/rpc",
          "host": ["{{baseUrl}}"],
          "path": ["rpc"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"op\": \"patient.search\",\n  \"data\": {\n    \"argument\": \"crm_offline_simulado\",\n    \"page\": 0,\n    \"sizePage\": 1\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Contrato { ok, data, error, meta }', () => {",
              "  pm.expect(json).to.have.property('ok');",
              "  pm.expect(json).to.have.property('data');",
              "  pm.expect(json).to.have.property('error');",
              "  pm.expect(json).to.have.property('meta');",
              "});",
              "pm.test('CRM offline respeita configuração', () => {",
              "  const enforceOffline = pm.collectionVariables.get('crmOffline') === 'true';",
              "  if (enforceOffline) {",
              "    pm.expect(json.ok).to.eql(false);",
              "  }",
              "});",
              "pm.test('Sem loop (tempo de resposta)', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(10000);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3333"
    },
    {
      "key": "crmOffline",
      "value": "false"
    }
  ]
}
