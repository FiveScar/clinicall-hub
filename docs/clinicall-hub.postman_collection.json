        ],
        "url": {
          "raw": "{{baseUrl}}/rpc",
          "host": ["{{baseUrl}}"],
          "path": ["rpc"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"op\": \"schedule.search\",\n  \"data\": {\n    \"companyId\": 1,\n    \"started\": \"2024-02-01\",\n    \"ended\": \"2024-02-07\"\n  }\n}"
        }
      },
