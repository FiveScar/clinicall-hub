{
  "info": {
    "name": "Clinicall Hub",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleção para validar RPCs do Clinicall Hub, garantindo o contrato { ok, data, error, meta } e evitando loops."
  },
  "item": [
    {
      "name": "RPC - Pacientes (search)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/rpc",
          "host": ["{{baseUrl}}"],
          "path": ["rpc"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"op\": \"patient.search\",\n  \"data\": {\n    \"argument\": \"\",\n    \"page\": 0,\n    \"sizePage\": 25,\n    \"fieldSort\": \"name\",\n    \"sortDirection\": \"asc\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Contrato { ok, data, error, meta }', () => {",
              "  pm.expect(json).to.have.property('ok');",
              "  pm.expect(json).to.have.property('data');",
              "  pm.expect(json).to.have.property('error');",
              "  pm.expect(json).to.have.property('meta');",
              "});",
              "pm.test('Sem loop (tempo de resposta)', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(10000);",
              "});"
            ]
          }
        }
      ]
    },
    {
